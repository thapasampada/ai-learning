# Email sender account. For Gmail, use a Google App Password (not your account password).
EMAIL_USER=your-account@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM=AI Learning Assistant <your-account@gmail.com>
EMAIL_SERVICE=gmail

# Optional: set these to use a custom SMTP provider instead of EMAIL_SERVICE.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Public URL of the frontend; reset links will point here.
FRONTEND_URL=http://localhost:5173
